// Generated with Fastfetch Config Editor
{
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/refs/heads/dev/doc/json_schema.json",
  "logo": {
    "type": "small"
  },
  "modules": [
    {
      "type": "title"
    },
    {
      "type": "separator"
    },
    {
      "type": "os",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "format": "{pacman}"
    },
    {
      "type": "cpu",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "format": "{name}",
      "hideType": "Integrated"
    },
    {
      "type": "memory"
    },
    {
      "type": "disk"
    },
    {
      "type": "monitor",
      "format": "{width}x{height}px @ {refresh-rate}Hz",
      "key": "Monitor"
    }
  ]
}
